APP_ENV=development
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./db/vision.db
IMAGE_STORAGE_PATH=./images
CAMERA_BACKEND=opencv
# Use CAMERA_DEVICE_PATH to target a specific Linux USB device node (preferred on Linux).
# Leave empty to fall back to the integer index in CAMERA_DEVICE_ID.
CAMERA_DEVICE_PATH=/dev/video0
CAMERA_DEVICE_ID=0
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080
CAMERA_EXPOSURE=-6.0
CAMERA_GAIN=0.0
OCR_ENGINE=TESSERACT
OCR_LANGUAGE=eng
OCR_PSM=6
OCR_WHITELIST=0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ./-
MIN_CONFIDENCE=60.0
DATE_REGEX=(\b(?:\d{2}[./-]\d{2}[./-]\d{2,4}|\d{4}[./-]\d{2}[./-]\d{2}|\d{6,8})\b)
BATCH_REGEX=\b([A-Z0-9]{2,4}[-/]?[A-Z0-9]{3,8})\b
DEFAULT_ROI_X=0
DEFAULT_ROI_Y=0
DEFAULT_ROI_W=640
DEFAULT_ROI_H=480
UPSCALE_FACTOR=2.0
THRESHOLD_MODE=OTSU
THRESHOLD_GLOBAL_VALUE=127
THRESHOLD_ADAPTIVE_BLOCK_SIZE=11
THRESHOLD_ADAPTIVE_C=2
CAPTURE_MODE=SINGLE
CAPTURE_N_FRAMES=5
LOG_LEVEL=INFO
